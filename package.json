{
  "name": "patchvault",
  "displayName": "PATCHVAULT",
  "description": "Autonomous AI Coding Agent & Recovery Flight Recorder powered by TrueForge",
  "version": "0.3.0",
  "publisher": "patchvault",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "compile:core": "tsc -p ./tsconfig.core.json",
    "test:core": "npm run compile:core && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "activationEvents": [
    "onView:patchvault.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PATCHVAULT runs your configured test command and writes files."
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "patchvault.inlineEdit",
        "title": "PATCHVAULT: Inline Edit with TrueForge Agent",
        "category": "PATCHVAULT"
      },
      {
        "command": "patchvault.undoLastChange",
        "title": "PATCHVAULT: Safe Undo / Revert Last Change",
        "category": "PATCHVAULT"
      },
      {
        "command": "patchvault.cancelRun",
        "title": "PATCHVAULT: Cancel Agent Generation",
        "category": "PATCHVAULT"
      },
      {
        "command": "patchvault.setApiKey",
        "title": "PATCHVAULT: Set TrueForge API Key",
        "category": "PATCHVAULT"
      },
      {
        "command": "patchvault.clearApiKey",
        "title": "PATCHVAULT: Clear TrueForge API Key",
        "category": "PATCHVAULT"
      }
    ],
    "keybindings": [
      {
        "command": "patchvault.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      },
      {
        "command": "patchvault.undoLastChange",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patchvault",
          "title": "PATCHVAULT",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "patchvault": [
        {
          "type": "webview",
          "id": "patchvault.sidebar",
          "name": "Flight Recorder"
        }
      ]
    },
    "configuration": {
      "title": "PATCHVAULT",
      "properties": {
        "patchvault.testCommand": {
          "type": "string",
          "default": "npm test",
          "description": "Command run by 'Run tests'. Executed in the workspace root."
        },
        "patchvault.trueforgeBaseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "URL of your primary TrueForge server."
        },
        "patchvault.trueforgeModel": {
          "type": "string",
          "default": "",
          "description": "Primary model name configured in TrueForge, e.g. anthropic/claude-3-5-sonnet or google-gemini/gemini-2.5-flash."
        },
        "patchvault.trueforgeFallbackBaseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "URL of secondary / fallback TrueForge server (Task C Resilience)."
        },
        "patchvault.trueforgeFallbackModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Secondary fallback model when primary is unreachable or key is invalid (Task C Resilience)."
        },
        "patchvault.contextBudgetTokens": {
          "type": "number",
          "default": 4000,
          "description": "Maximum token budget for automatic context retrieval (~16,000 characters)."
        },
        "patchvault.syncRemoteEdits": {
          "type": "boolean",
          "default": false,
          "description": "Whether TrueForge tool writes sync directly to workspace or queue for hunk review."
        }
      }
    }
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.185.0"
  }
}
